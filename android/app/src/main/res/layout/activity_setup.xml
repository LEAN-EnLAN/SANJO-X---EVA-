<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="@null"
            android:src="@drawable/eva_mark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/setup_title"
            android:textColor="@color/eva_ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/setup_lead"
            android:textColor="@color/eva_muted"
            android:textSize="15sp" />

        <TextView
            style="@style/Eva.Label"
            android:text="@string/hub_address" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:background="@drawable/field_bg"
            android:fontFamily="monospace"
            android:hint="@string/hub_address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/eva_ink"
            android:textColorHint="@color/eva_muted"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/hub_address_help"
            android:textColor="@color/eva_muted"
            android:textSize="13sp" />

        <TextView
            style="@style/Eva.Label"
            android:text="@string/scheme" />

        <RadioGroup
            android:id="@+id/scheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/scheme_https"
                style="@style/Eva.Radio"
                android:text="@string/scheme_https" />

            <RadioButton
                android:id="@+id/scheme_http"
                style="@style/Eva.Radio"
                android:text="@string/scheme_http" />
        </RadioGroup>

        <TextView
            android:id="@+id/voice_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/eva_muted"
            android:textSize="13sp" />

        <TextView
            style="@style/Eva.Label"
            android:text="@string/open_as" />

        <RadioGroup
            android:id="@+id/seats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/keep_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/keep_screen_on"
            android:textColor="@color/eva_ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keep_screen_on_help"
            android:textColor="@color/eva_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/pin_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/field_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/pin_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/eva_muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/forget_pin"
                style="@style/Eva.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/button_secondary"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/forget_cert"
                android:textColor="@color/eva_ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/form_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/eva_critical"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/connect"
            style="@style/Eva.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_primary"
            android:text="@string/connect"
            android:textColor="@color/eva_background" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/eva_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
