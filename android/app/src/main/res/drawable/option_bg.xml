<?xml version="1.0" encoding="utf-8"?>
<!-- A mode choice on the setup screen: black with the landing's #2a2a2a hairline, no coloured fill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22F4F3F0">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/eva_background" />
                    <stroke android:width="1dp" android:color="@color/eva_teal" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/eva_background" />
                    <stroke android:width="1dp" android:color="@color/eva_line" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
